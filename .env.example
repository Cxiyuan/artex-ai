# Docker 部署配置（复制为 .env）
# CI 构建的镜像（ghcr.io，多架构 amd64/arm64）
# 固定版本：:v2.2.0 / :sha-66754b3；自建镜像：artex-ai:latest
APAGENT_IMAGE=ghcr.io/cxiyuan/artex-ai:latest
POSTGRES_USER=apagent
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=apagent

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
APAGENT_LLM_PROVIDER=
APAGENT_LLM_MODEL=
APAGENT_LLM_BASE_URL=
APAGENT_LLM_PROXY=
